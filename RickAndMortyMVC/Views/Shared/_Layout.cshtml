<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Explorador de l'univers Rick & Morty: personatges, episodis i favorits." />
    <title>@ViewData["Title"] — Rick &amp; Morty Explorer</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />

    <link rel="stylesheet" href="~/css/site.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Salta al contingut principal</a>

    <header role="banner">
        <nav class="navbar navbar-expand-lg" aria-label="Navegació principal">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="Inici - Rick and Morty Explorer">
                    <svg class="brand-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                        <circle cx="18" cy="18" r="16" stroke="#39d353" stroke-width="2"/>
                        <circle cx="18" cy="18" r="10" stroke="#00d4ff" stroke-width="1.5" opacity="0.6"/>
                        <circle cx="18" cy="18" r="5" fill="#39d353" opacity="0.8"/>
                    </svg>
                    R&amp;M Explorer
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav"
                        aria-controls="mainNav"
                        aria-expanded="false"
                        aria-label="Obrir menú de navegació">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto" role="list">
                        <li class="nav-item" role="listitem">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index"
                               aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "page" : null)">
                                Inici
                            </a>
                        </li>
                        <li class="nav-item" role="listitem">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Characters" ? "active" : "")"
                               asp-controller="RickAndMorty" asp-action="Characters"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Characters" ? "page" : null)">
                                Personatges
                            </a>
                        </li>
                        <li class="nav-item" role="listitem">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Episodes" ? "active" : "")"
                               asp-controller="RickAndMorty" asp-action="Episodes"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Episodes" ? "page" : null)">
                                Episodis
                            </a>
                        </li>
                        <li class="nav-item" role="listitem">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Favorites" ? "active" : "")"
                               asp-controller="RickAndMorty" asp-action="Favorites"
                               aria-current="@(ViewContext.RouteData.Values["action"]?.ToString() == "Favorites" ? "page" : null)">
                                Favorits
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main" tabindex="-1">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-custom alert-success-custom mt-3" role="alert" aria-live="polite">
                    <span aria-hidden="true">✓</span>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert-custom alert-info-custom mt-3" role="alert" aria-live="polite">
                    <span aria-hidden="true">ℹ</span>
                    <span>@TempData["InfoMessage"]</span>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer role="contentinfo">
        <div class="container">
            <p>
                Rick &amp; Morty Explorer — Projecte Final MP09 |
                Dades de <a href="https://rickandmortyapi.com" target="_blank" rel="noopener noreferrer"
                            aria-label="API de Rick and Morty (s'obre en una nova pestanya)">
                    rickandmortyapi.com
                </a>
            </p>
            <p class="mt-1" style="font-size:0.75rem;">
                Desenvolupat amb .NET Core MVC · C# · Entity Framework SQLite · Newtonsoft.Json
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>