@model List<FavoriteCharacter>
@{
    ViewData["Title"] = "Favorits";
}

<div class="py-4">
    <p class="section-title" aria-hidden="true">Col·lecció Personal</p>
    <h1>Els Meus Favorits
        @if (Model.Any())
        {
            <span style="color:var(--text-muted);font-size:1rem;font-family:var(--font-body);">
                (@Model.Count personatge@(Model.Count != 1 ? "s" : ""))
            </span>
        }
    </h1>
    <p style="color:var(--text-muted);font-size:.9rem;" class="mt-2">
        Guardats a la base de dades local SQLite. Afegeix personatges des del seu detall.
    </p>
</div>

@if (Model.Any())
{
    <section aria-label="Llista de personatges favorits">
        <div class="row g-3" role="list">
            @foreach (var fav in Model)
            {
                <div class="col-md-6 col-lg-4" role="listitem">
                    <article class="favorite-card" aria-label="@fav.Name als favorits">
                        <img src="@fav.ImageUrl"
                             alt="@fav.ImageAltText"
                             class="favorite-card__img"
                             width="72" height="72"
                             loading="lazy" />

                        <div class="favorite-card__info">
                            <h2 class="favorite-card__name">@fav.Name</h2>
                            <p style="font-size:.8rem;color:var(--text-muted);margin:.1rem 0;">
                                @fav.Species · @fav.Gender
                            </p>
                            <span class="status-badge @fav.StatusCssClass"
                                  aria-label="Estat: @fav.Status"
                                  style="font-size:.65rem;">
                                @fav.Status
                            </span>
                            <p class="favorite-card__date">
                                Afegit: <time datetime="@fav.AddedAt.ToString("yyyy-MM-dd")">
                                    @fav.AddedAt.ToString("dd/MM/yyyy HH:mm")
                                </time>
                            </p>
                        </div>

                        <div style="display:flex;flex-direction:column;gap:.5rem;align-items:flex-end;">
                            <a asp-controller="RickAndMorty" asp-action="Character" asp-route-id="@fav.CharacterId"
                               class="btn-outline-custom"
                               style="font-size:.65rem;padding:.4rem .8rem;"
                               aria-label="Veure detall de @fav.Name">
                                Detall
                            </a>

                            <form asp-action="RemoveFavorite" asp-controller="RickAndMorty" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@fav.CharacterId" />
                                <button type="submit" class="btn-danger-custom"
                                        aria-label="Eliminar @fav.Name dels favorits"
                                        style="font-size:.65rem;">
                                    ✕ Eliminar
                                </button>
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}
else
{
    <div class="empty-state" role="status">
        <span class="empty-state__icon" aria-hidden="true">★</span>
        <h2 class="empty-state__title">Encara no tens favorits</h2>
        <p>Explora els personatges i afegeix-los a la teva col·lecció personal.</p>
        <a asp-controller="RickAndMorty" asp-action="Characters"
           class="btn-primary-custom mt-3"
           aria-label="Anar a la llista de personatges per afegir favorits">
            Explorar Personatges
        </a>
    </div>
}